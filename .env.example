# Copy this file to .env.local for local development.
# On Vercel, set these under Project Settings -> Environment Variables instead
# (DATABASE_URL is injected automatically once you connect the Neon integration — see README.md).

# --- Database (Neon / any Postgres) ---
# Use the POOLED connection string (the one Neon labels "pooled connection", PgBouncer) —
# required for serverless functions, a direct connection will run out of slots under load.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Stripe ---
# Secret key: Stripe Dashboard -> Developers -> API keys (use a *test* key while building)
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret: Stripe Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Pricing (see the pricing doc / launch playbook — this is still an open decision) ---
# Amounts in CENTS. Defaults below ($1) match the current Claude Design mock.
# Raise these once you've decided on the institutional minimum (e.g. 25000 = $250).
MIN_ENTRY_CENTS=100
MIN_INCREMENT_CENTS=100

# --- Misc ---
# Used as a fallback for Stripe redirect URLs when the `origin` header is missing
# (e.g. server-to-server calls). Not needed for normal browser checkout.
PUBLIC_SITE_URL=https://your-domain.com
